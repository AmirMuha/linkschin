# Backend API Configuration
LINKSCHIN_ENV=development
API_PORT=8000
API_HOST=0.0.0.0

# LLM / LangChain Configuration (Cloud API)
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Operator Authentication (Required for source management)
JWT_SECRET_KEY=change-this-to-a-cryptographically-secure-random-secret-key-in-production
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=change-to-strong-password

# Crawler Settings
CRAWL_INTERVAL_SECONDS=300
MAX_CONCURRENCY_PER_DOMAIN=2
DEFAULT_DOMAIN_DELAY_SECONDS=1.0
